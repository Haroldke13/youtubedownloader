# Copy to .env and fill in real values. NEVER commit .env.
# Variable NAMES only - no real secrets belong in this file.

# Flask session-signing key (generate with: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Optional: override the download directory for the built-in downloader.
# Keep it dedicated (e.g. ~/Downloads/YTDownloads) - the Files browser lists
# whatever is under it, so pointing this at all of ~/Downloads lists everything.
DOWNLOAD_DIR=

# Optional: path to the standalone dlallbpm.py used by the BPM downloader
DLALLBPM_PATH=

# Optional: where dlallbpm.py writes its library (must match dlallbpm's own path)
BPM_DOWNLOAD_DIR=

# Optional: browser whose cookies yt-dlp reuses when no cookies.txt exists
COOKIES_BROWSER=
